generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  nama_role String   @unique // Contoh isi: "user", "admin", "super_admin"
  createdAt DateTime @default(now()) @map("created_at")

  users User[] // Relasi kebalikannya: Satu role bisa dimiliki banyak user

  @@map("tb_roles")
}

model User {
  id          Int     @id @default(autoincrement())
  username    String
  email       String  @unique
  password    String
  foto_profil String?

  roleId    Int      @default(1) @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  laporan        Laporan[]
  komentar       Komentar[]
  notifikasi     Notification[]
  balasKomentars BalasKomentar[]

  @@map("tb_users")
}

model Kategori {
  id            Int    @id @default(autoincrement())
  nama_kategori String

  laporan Laporan[]

  @@map("tb_kategori")
}

model Laporan {
  id          Int      @id @default(autoincrement())
  id_user     Int
  judul       String
  gambar      String?
  deskripsi   String
  lokasi      String
  kategori_id Int
  status      String   @default("menunggu")
  create_at   DateTime @default(now())

  user          User           @relation(fields: [id_user], references: [id])
  kategori      Kategori       @relation(fields: [kategori_id], references: [id])
  komentar      Komentar[]
  notifications Notification[]

  @@map("tb_laporan")
}

model Komentar {
  id           Int      @id @default(autoincrement())
  id_user      Int
  id_laporan   Int
  isi_komentar String
  created_at   DateTime @default(now())

  user          User            @relation(fields: [id_user], references: [id])
  laporan       Laporan         @relation(fields: [id_laporan], references: [id])
  balasKomentar BalasKomentar[]
  notifications Notification[]

  @@map("tb_komentar")
}

model BalasKomentar {
  id             Int      @id @default(autoincrement())
  id_user        Int //
  id_komentar    Int
  balas_komentar String
  created_at     DateTime @default(now())

  user     User     @relation(fields: [id_user], references: [id])
  komentar Komentar @relation(fields: [id_komentar], references: [id])

  @@map("tb_balas_komentar")
}

model Notification {
  id             Int      @id @default(autoincrement())
  id_user        Int
  id_laporan     Int?
  id_komentar    Int?
  isi_notifikasi String
  is_read        Boolean  @default(false) // Tambahan krusial: Untuk menandai notifikasi sudah dibaca atau belum
  created_at     DateTime @default(now())

  user     User      @relation(fields: [id_user], references: [id], onDelete: Cascade)
  laporan  Laporan?  @relation(fields: [id_laporan], references: [id], onDelete: Cascade)
  komentar Komentar? @relation(fields: [id_komentar], references: [id], onDelete: Cascade)

  @@map("tb_notifikasi")
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  activity   String
  created_at DateTime @default(now())

  @@map("tb_log_aktifitas")
}
