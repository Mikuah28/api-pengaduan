{
  "name": "laporan-pengaduan-api",
  "version": "1.0.0",
  "description": "API Laporan Pengaduan Masyarakat dengan Elysia.js + Prisma + PostgreSQL",
  "module": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.js",
    "start": "bun src/index.js",
    "db:migrate": "bunx prisma migrate dev",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:studio": "bunx prisma studio",
    "db:seed": "bun prisma/seed.js",
    "build": "bun run build && bunx prisma generate && bunx prisma migrate deploy"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/jwt": "^1.1.1",
    "@elysiajs/static": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "@types/bun": "^1.3.14",
    "bcryptjs": "^2.4.3",
    "elysia": "^1.4.28"
  },
  "devDependencies": {
    "bun-types": "latest",
    "prisma": "^5.22.0"
  }
}
